# Exemple de variables injectées par l'environnement d'exécution.
# Django ne charge pas automatiquement ce fichier : ne le renommez pas en
# .env sans configurer explicitement votre gestionnaire de processus.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=label.example.sn
DJANGO_CSRF_TRUSTED_ORIGINS=https://label.example.sn
MAX_APPLICATION_UPLOAD_BYTES=104857600
PUBLIC_CERTIFICATE_VERIFICATION_URL=https://label.example.sn/verification-certificat?number={number}
